; __PREFIX__: __ID__ walks a patrol path (way points in all.spawn: way_<level>.ltx; vanilla paths
; can be reused, e.g. esc_lager_defend1_walk / _look). Check a path exists in game:
;   level.patrol_path_exists("name")
[logic]
active = walker@patrol

[walker@patrol]
danger = __PREFIX___no_danger
path_walk = CHANGE_ME_walk
path_look = CHANGE_ME_look
; bangs (explosions, fireworks, shots nearby) must not send the NPC running for cover
[__PREFIX___no_danger]
ignore_types = grenade, corpse, hit, sound
ignore_distance = 0

; without this the nearest smart terrain hands the NPC a vanilla gulag job that overrides this logic
[smart_terrains]
none = true